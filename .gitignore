# Virtual environment
venv/
.venv/

# Environment secrets
.env

# Index files (indexes/: Chroma ~33 MB + bm25.json ~8 MB + manifest) are committed
# for Streamlit Community Cloud deployment, which needs them at runtime.
# A stray Chroma DB is created if the app is started with a cwd-relative path:
app/indexes/

# Raw PDFs (large binaries — keep processed/chunks.jsonl for reproducibility)
data/raw/*.pdf
data/raw/circulars/*.pdf

# Python bytecode
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Windows download metadata
*:Zone.Identifier

# Local tooling / caches
.cortex/
.pytest_cache/
.ruff_cache/
eval/results/latest.*

# User-uploaded documents (may be copyrighted; never commit)
data/user/
logs/
