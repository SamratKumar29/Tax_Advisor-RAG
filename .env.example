LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Primary model; leave empty to require entry in the UI sidebar.
LLM_MODEL=upstage/solar-mini4
#LLM_MODEL=xiaomi/mimo-v2.5
# Comma-separated models tried in order.
FALLBACK_MODELS=inclusionai/ling-3.1-flash,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free,inclusionai/ling-3.1-flash,inclusionai/ling-3.0-flash-vl,xiaomi/mimo-v2.6-flash,meta-llama/llama-4-scout,upstage/solar-pro4
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
MAX_QUERY_CHARS=2000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Relative paths resolve against the project root.
CHROMA_PERSIST_DIR=indexes/chroma
BM25_INDEX_PATH=indexes/bm25.json

# ── Retrieval (defaults are the measured best; see eval/results/n1_final.md) ──
#BM25_QUERY_EXPANSION=1          # "slab" → "rate of tax", "TDS" → "deduction of tax at source", ...
#RRF_DENSE_WEIGHT=1.0
#RRF_BM25_WEIGHT=1.5
#SECTION_HEADER_IN=              # "bm25", "dense" or "bm25,dense"; measured worse, rebuild with make index
#ABSTAIN_DENSE_THRESHOLD=0.68    # answer "not found" without an LLM call below this; 0 disables
#LLM_QUERY_REWRITE=0             # +1 LLM call per question; measured worse (eval/results/n1_llm_rewrite.md)
#CONVERSATION_MEMORY=0           # +1 LLM call per follow-up; rewrites it into a standalone question
#MEMORY_TURNS=3
# ── Logging and uploads ──
#QUERY_LOG_PATH=logs/queries.jsonl   # contains users' questions; set empty to disable
#USER_DOCS_DIR=data/user
#MAX_UPLOAD_MB=15
#MAX_UPLOAD_PAGES=500
