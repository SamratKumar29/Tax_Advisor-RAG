LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Primary model; leave empty to require entry in the UI sidebar.
LLM_MODEL=
# Comma-separated models tried in order if the primary model fails.
FALLBACK_MODELS=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
MAX_QUERY_CHARS=2000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Relative paths resolve against the project root.
CHROMA_PERSIST_DIR=indexes/chroma
BM25_INDEX_PATH=indexes/bm25.json
